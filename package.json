{
  "name": "ambulanta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": "10.2.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-viewer.mjs && next dev",
    "build": "node scripts/prepare-pdf-viewer.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file=.env.local tests/integration/access.mjs && node --env-file=.env.local tests/integration/people-vehicles.mjs && node --env-file=.env.local tests/integration/catalog.mjs && node --env-file=.env.local tests/integration/inventory.mjs && node --env-file=.env.local tests/integration/shifts.mjs && node --env-file=.env.local tests/integration/evidence.mjs",
    "test:integration:cleanup": "node --env-file=.env.local scripts/cleanup-m02-fixtures.mjs",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "seed:m03": "node --env-file=.env.local scripts/seed-m03-demo.mjs",
    "seed:m04": "node --env-file=.env.local scripts/seed-m04-demo.mjs",
    "seed:m05": "node --env-file=.env.local scripts/seed-m05-demo.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
