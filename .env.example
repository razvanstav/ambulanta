# Copiază în .env.local; valorile reale nu se salvează în Git.
# Fără conexiune, doar /demo este disponibil pentru previzualizarea interfeței.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cheile privilegiate Supabase nu primesc niciodată prefixul NEXT_PUBLIC_.
# Folosită numai pe server pentru crearea conturilor Auth și scripturile administrative.
SUPABASE_SECRET_KEY=

# Pe Netlify, secret separat ca nume, folosit exclusiv de validatorul dovezilor.
# Valoarea se configurează secretă, numai în contextul Production.
SUPABASE_EVIDENCE_SECRET_KEY=
# Netlify configurează 4 în netlify.toml; implicit local: 10 MB.
NEXT_PUBLIC_EVIDENCE_MAX_MB=

# Opțional, obligatoriu explicit pentru testele care creează/șterg fixture fictivă.
M02_TEST_PROJECT_REF=
